# syntax=docker/dockerfile:1
# shortcut: tags not digests; pin @sha256 digests before the first production deploy (§12).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props TimeCheck.sln ./
COPY src/ src/
RUN dotnet publish src/TimeCheck.Api/TimeCheck.Api.csproj -c Release -o /app --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:11.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080 DOTNET_RUNNING_IN_CONTAINER=true
COPY --from=build /app .
USER $APP_UID
EXPOSE 8080
# The aspnet image has no curl; bash's /dev/tcp is enough to hit the liveness endpoint.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8080 && printf 'GET /health/live HTTP/1.0\\r\\n\\r\\n' >&3 && head -1 <&3 | grep -q ' 200 '"]
ENTRYPOINT ["dotnet", "TimeCheck.Api.dll"]
