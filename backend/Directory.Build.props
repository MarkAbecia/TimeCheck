<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1707: xunit test names use underscores; CA1848/CA1873: LoggerMessage not worth it for low-volume logs; CA2007: no ConfigureAwait in ASP.NET Core; CA1716: VB keyword clashes (Event) irrelevant -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1873;CA2007;CA1515;CA1062;CA1716;CA1725</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
