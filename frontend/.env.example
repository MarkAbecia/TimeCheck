# Copy to .env.development.local. Server-only: none of these reach the browser.
SUPABASE_URL=http://127.0.0.1:55421
# From `supabase status` (the publishable key, sb_publishable_...). Never the secret key.
SUPABASE_PUBLISHABLE_KEY=
API_URL=http://localhost:5170
APP_URL=http://localhost:3400
# Optional: rate limits fall back to in-memory without it.
REDIS_URL=
CHURCH_NAME=TimeCheck
